<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Agrega un bloque de resumen de pesaje al final del remito de entrega
        cuando el picking tiene operaciones pesadas.

        En Odoo 19, el template stock.report_delivery_document usa 'o' como
        variable principal (el stock.picking), no 'doc'.
    -->
    <!-- Protege image_data_uri cuando o.signature es False (campo vacío) -->
    <!-- Nota: el AttributeError de l10n_ar_cai_data.get() sobre un False ya está
         corregido upstream en ingadhoc/argentina-sale (usa (o.l10n_ar_cai_data or {}).get()),
         por eso no se parchea acá. -->
    <template id="fix_delivery_document_signature"
              inherit_id="l10n_ar_stock_ux.report_delivery_document">
        <xpath expr="//img[@t-att-src='image_data_uri(o.signature)']" position="attributes">
            <attribute name="t-if">o.signature</attribute>
        </xpath>
    </template>

    <!--
        El remito imprime o.weight, que es el peso ESTIMADO calculado desde el
        maestro de productos. Para productos pesables el peso real ya está en
        shipping_weight (nuestro _compute_shipping_weight usa recorded_weight).

        shipping_weight también es correcto sin pesaje: cae al cálculo estándar
        product.weight x cantidad. Se deja o.weight como respaldo por si quedara
        en cero.
    -->
    <template id="delivery_document_shipping_weight"
              inherit_id="l10n_ar_stock_delivery.report_delivery_document">
        <xpath expr="//span[@t-field='o.weight']" position="replace">
            <span t-out="o.shipping_weight or o.weight"
                  t-options='{"widget": "float", "precision": 2}'/>
        </xpath>
    </template>

    <template id="stock_picking_weighing_section"
              inherit_id="l10n_ar_stock_ux.report_delivery_document">
        <table name="stock_move_line_table" position="after">
            <t t-set="weighing_details" t-value="o._get_weighing_detail_lines()"/>
            <t t-if="weighing_details">
                <div class="mt-4 page-break-inside-avoid">
                    <h5>Detalle de Pesaje</h5>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Lote / N° Serie</th>
                                <th class="text-end">Cantidad</th>
                                <th class="text-end">Peso</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Agrupado por producto y lote: sin lotes, las piezas
                                 de un mismo producto se suman en una sola fila. -->
                            <t t-foreach="weighing_details" t-as="detail">
                                <tr>
                                    <td>
                                        <span t-esc="detail['name']"/>
                                    </td>
                                    <td>
                                        <span t-esc="detail['lot_name']"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="'%.0f' % detail['quantity']"/>
                                        <span class="ms-1" t-esc="detail['uom_name']"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="'%.3f' % detail['weight']"/>
                                        <span class="ms-1" t-esc="detail['weighing_uom_name']"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td colspan="3" class="text-end">Peso total:</td>
                                <td class="text-end">
                                    <span t-esc="'%.3f' % sum(d['weight'] for d in weighing_details)"/>
                                    <span class="ms-1">kg</span>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </table>
    </template>

    <!--
        Extiende el reporte de operaciones de recolección (Picking) para
        mostrar peso estimado y entregado por línea, y la sección "Detalle
        de Pesaje" al final. Solo se activa si:
          - La empresa tiene use_stock_weighing = True
          - El picking tiene al menos un move con has_weight = True
    -->
    <template id="stock_report_picking_weighing"
              inherit_id="stock.report_picking">
        <!-- Sección Detalle de Pesaje al final del reporte -->
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-if="o.company_use_stock_weighing and o.has_weighing_operations">
                <div class="mt-4 page-break-inside-avoid">
                    <h5>Detalle de Pesaje</h5>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th class="text-end">Peso Estimado</th>
                                <th class="text-end">Peso Entregado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.move_ids.filtered(lambda m: m.has_weight)" t-as="m">
                                <tr>
                                    <td><span t-esc="m.product_id.display_name"/></td>
                                    <td class="text-end">
                                        <span t-esc="'%.3f' % m.planned_weight"/>
                                        <span class="ms-1" t-esc="m.weighing_uom_name"/>
                                    </td>
                                    <td class="text-end">
                                        <t t-if="m.recorded_weight">
                                            <span t-esc="'%.3f' % m.recorded_weight"/>
                                            <span class="ms-1" t-esc="m.weighing_uom_name"/>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td colspan="2" class="text-end">Peso total entregado:</td>
                                <td class="text-end">
                                    <t t-set="total_entregado" t-value="sum(o.move_ids.filtered(lambda m: m.has_weight and m.recorded_weight).mapped('recorded_weight'))"/>
                                    <t t-if="total_entregado">
                                        <span t-esc="'%.3f' % total_entregado"/>
                                        <span class="ms-1">kg</span>
                                    </t>
                                    <t t-else="">—</t>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
