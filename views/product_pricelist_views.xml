<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_pricelist_item_form_weighing" model="ir.ui.view">
        <field name="name">product.pricelist.item.form.weighing</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            <field name="price" position="after">
                <field name="is_weighed_price" string="Precio por peso"/>
            </field>
            <xpath expr="//group[@name='price_discount']" position="after">
                <group string="Weight Price" invisible="not is_weighed_price">
                    <group>
                        <field name="ppw_compute_price" required="is_weighed_price"/>
                        <field name="price_per_weight" invisible="ppw_compute_price != 'fixed'" required="ppw_compute_price == 'fixed'"/>
                        <label for="price_per_weight" string="Base Price" invisible="ppw_compute_price != 'formula'"/>
                        <div class="o_row" invisible="ppw_compute_price != 'formula'">
                            <field name="ppw_base"/>
                            <span invisible="ppw_base != 'pricelist'">
                                <field name="ppw_pricelist_id" class="oe_inline"/>
                            </span>
                        </div>
                        <field name="ppw_percent_price" invisible="ppw_compute_price != 'formula'" string="Margin (%)"/>
                        <field name="ppw_price_surcharge" invisible="ppw_compute_price != 'formula'" string="Extra Fee"/>
                    </group>
                    <group invisible="ppw_compute_price != 'formula'" string="Margins">
                        <field name="ppw_price_min_margin"/>
                        <field name="ppw_price_max_margin"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="product_pricelist_item_tree_weighing" model="ir.ui.view">
        <field name="name">product.pricelist.item.tree.weighing</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_tree_view"/>
        <field name="arch" type="xml">
            <field name="price" position="after">
                <field name="is_weighed_price" string="Precio por peso" optional="hide"/>
                <field name="ppw_compute_price" string="Mode" optional="hide"/>
                <field name="price_per_weight" string="Precio/kg" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
