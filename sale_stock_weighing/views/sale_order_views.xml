<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_view_weighing" model="ir.ui.view">
        <field name="name">sale.order.form.weighing</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Campo invisible para que column_invisible pueda leerlo desde la lista -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="company_use_stock_weighing" invisible="1"/>
            </xpath>

            <!-- Para productos pesables, el precio unitario es calculado (p/peso × peso);
                 se grisa para que el usuario edite solo el precio por peso. -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                <attribute name="readonly">product_id.is_weighed_product</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="price_per_weight"
                       optional="show"
                       column_invisible="not parent.company_use_stock_weighing"
                       invisible="not product_id.is_weighed_product"/>
                <field name="x_piece_count"
                       optional="show"
                       column_invisible="not parent.company_use_stock_weighing"
                       invisible="not product_id.is_weighed_product"
                       string="Piezas"/>
                <field name="total_planned_weight"
                       optional="show"
                       column_invisible="not parent.company_use_stock_weighing"
                       invisible="not product_id.is_weighed_product"
                       string="Peso Estimado"/>
                <field name="total_delivered_weight"
                       optional="show"
                       column_invisible="not parent.company_use_stock_weighing"
                       invisible="not product_id.is_weighed_product"
                       string="Peso Entregado"/>
                <field name="delivered_piece_count"
                       optional="hide"
                       column_invisible="not parent.company_use_stock_weighing"
                       invisible="not product_id.is_weighed_product"
                       string="Piezas Entregadas"/>
            </xpath>
        </field>
    </record>
</odoo>
