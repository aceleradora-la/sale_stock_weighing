<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_batch_picking_weighing" model="ir.actions.report">
        <field name="name">Hoja de Pesaje por Lote</field>
        <field name="model">stock.picking.batch</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_stock_weighing.report_batch_picking_weighing</field>
        <field name="report_file">sale_stock_weighing.report_batch_picking_weighing</field>
        <field name="print_report_name">'Hoja_Pesaje_' + (object.name or 'Lote')</field>
        <field name="binding_model_id" ref="stock_picking_batch.model_stock_picking_batch"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_batch_picking_weighing">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="batch">
                <t t-call="web.internal_layout">
                    <div class="page" style="font-size: 10.5pt; font-family: Arial, sans-serif;">

                        <div style="display: flex; justify-content: space-between; align-items: flex-start;
                                    border-bottom: 1.5pt solid #333; padding-bottom: 4pt; margin-bottom: 10pt;">
                            <div>
                                <div style="font-size: 13pt; font-weight: bold;">
                                    Hoja de pesaje — <span t-esc="batch.name"/>
                                </div>
                                <div style="font-size: 9pt; color: #555; margin-top: 2pt;">
                                    <span t-esc="batch.company_id.name"/>
                                    <t t-if="batch.user_id">
                                        &#160;·&#160; Operario: <span t-esc="batch.user_id.name"/>
                                    </t>
                                    &#160;·&#160; <span t-esc="batch.scheduled_date and batch.scheduled_date.strftime('%d/%m/%Y') or ''"/>
                                </div>
                            </div>
                            <div style="text-align: right; font-size: 9pt; color: #555;">
                                <div><span t-esc="len(batch.picking_ids)"/> pedidos</div>
                                <div>
                                    <t t-set="total_weight" t-value="sum(m.planned_weight for p in batch.picking_ids for m in p.move_ids if m.has_weight)"/>
                                    Peso est. total: <strong><span t-esc="'%.3f' % total_weight"/> kg</strong>
                                </div>
                            </div>
                        </div>

                        <t t-foreach="batch.picking_ids.sorted(key=lambda p: p.name)" t-as="picking">
                            <t t-set="weighable_moves" t-value="picking.move_ids.filtered(lambda m: m.state not in ('cancel', 'done'))"/>
                            <t t-if="weighable_moves">
                                <div style="border: 0.5pt solid #bbb; border-radius: 4pt;
                                            margin-bottom: 7pt; overflow: hidden; page-break-inside: avoid;">

                                    <div style="display: flex; justify-content: space-between; align-items: flex-start;
                                                background: #f2f2f2; padding: 3pt 6pt;
                                                border-bottom: 0.5pt solid #ccc;">
                                        <div style="display: flex; align-items: baseline; gap: 8pt;">
                                            <span style="font-weight: bold; font-size: 10pt;">
                                                <t t-esc="picking.sale_id.name or picking.name"/>
                                            </span>
                                            <span style="font-weight: bold; font-size: 9pt; color: #333;">
                                                <t t-esc="picking.partner_id.name or ''"/>
                                            </span>
                                        </div>
                                        <div style="text-align: right; font-size: 8.5pt; color: #555;">
                                            <t t-if="picking.partner_id.street">
                                                <span t-esc="picking.partner_id.street"/>
                                                <t t-if="picking.partner_id.city">
                                                    , <span t-esc="picking.partner_id.city"/>
                                                </t>
                                            </t>
                                        </div>
                                    </div>

                                    <table style="width: 100%; border-collapse: collapse; font-size: 9pt;">
                                        <thead>
                                            <tr style="background: #fafafa; border-bottom: 0.5pt solid #ddd;">
                                                <th style="padding: 2pt 5pt; text-align: left; font-weight: 600;
                                                           color: #444; width: 44%;">Producto</th>
                                                <th style="padding: 2pt 5pt; text-align: right; font-weight: 600;
                                                           color: #444; width: 14%;">Cantidad</th>
                                                <th style="padding: 2pt 5pt; text-align: right; font-weight: 600;
                                                           color: #444; width: 14%;">Peso est.</th>
                                                <th style="padding: 2pt 5pt; text-align: center; font-weight: 600;
                                                           color: #444; width: 14%;">Lote</th>
                                                <th style="padding: 2pt 5pt; text-align: right; font-weight: 600;
                                                           color: #444; width: 14%;">Peso real</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="weighable_moves" t-as="move">
                                                <tr style="border-bottom: 0.3pt solid #eee;">
                                                    <td style="padding: 2pt 5pt;">
                                                        <span t-esc="move.product_id.display_name"/>
                                                    </td>
                                                    <td style="padding: 2pt 5pt; text-align: right;">
                                                        <span t-esc="'%.0f' % move.product_uom_qty"/>
                                                        <span style="color: #777; margin-left: 2pt;"
                                                              t-esc="move.product_uom.name"/>
                                                    </td>
                                                    <td style="padding: 2pt 5pt; text-align: right;">
                                                        <t t-if="move.has_weight">
                                                            <span t-esc="'%.3f' % move.planned_weight"/>
                                                            <span style="color: #777; margin-left: 2pt;"
                                                                  t-esc="move.weighing_uom_name"/>
                                                        </t>
                                                        <t t-else="">—</t>
                                                    </td>
                                                    <td style="padding: 2pt 5pt; text-align: center;
                                                               color: #777; font-size: 8.5pt;">
                                                        <t t-esc="move.lot_names or ''"/>
                                                    </td>
                                                    <td style="padding: 2pt 5pt; text-align: right;">
                                                        <t t-if="move.has_weight">
                                                            <span style="display: inline-block; width: 48pt;
                                                                         border-bottom: 0.8pt solid #888;"/>
                                                        </t>
                                                        <t t-else="">—</t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                        <t t-set="picking_weight" t-value="sum(m.planned_weight for m in weighable_moves if m.has_weight)"/>
                                        <t t-if="picking_weight > 0">
                                            <tfoot>
                                                <tr style="background: #f8f8f8; border-top: 0.5pt solid #ccc;">
                                                    <td colspan="2" style="padding: 2pt 5pt; text-align: right;
                                                                           color: #555; font-size: 8.5pt;">
                                                        Peso estimado pedido:
                                                    </td>
                                                    <td style="padding: 2pt 5pt; text-align: right; font-weight: bold;">
                                                        <span t-esc="'%.3f' % picking_weight"/> kg
                                                    </td>
                                                    <td style="padding: 2pt 5pt; text-align: right;
                                                               color: #555; font-size: 8.5pt;">
                                                        Peso real total:
                                                    </td>
                                                    <td style="padding: 2pt 5pt; text-align: right;">
                                                        <span style="display: inline-block; width: 48pt;
                                                                     border-bottom: 0.8pt solid #888;"/>
                                                    </td>
                                                </tr>
                                            </tfoot>
                                        </t>
                                    </table>
                                </div>
                            </t>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
