<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_form_inherit_weighing" model="ir.ui.view">
        <field name="name">res.company.form.weighing</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.res_company_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Pesaje" name="stock_weighing">
                    <group>
                        <field name="use_stock_weighing"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
