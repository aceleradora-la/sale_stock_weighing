<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sale_stock_weighing.WeighingRecord" owl="1">
        <div class="o_weighing_record_card">
            <div class="o_weighing_record_header">
                <strong><t t-esc="props.record.data.product_id[1]"/></strong>
            </div>
            <div class="o_weighing_record_body">
                <div class="mb-2">
                    <label>Weight</label>
                    <input type="number"
                           class="form-control o_weighing_weight_input"
                           t-model="state.weight"
                           step="0.001"
                           min="0"/>
                </div>
                <div class="mb-2" t-if="props.record.data.product_tracking !== 'none'">
                    <label>Lot/Serial Number</label>
                    <select class="form-control"
                            t-model="state.lot_id">
                        <option value="">Select lot...</option>
                        <t t-foreach="props.record.data.available_lot_ids || []" t-as="lot" t-key="lot[0]">
                            <option t-att-value="lot[0]"><t t-esc="lot[1]"/></option>
                        </t>
                    </select>
                </div>
            </div>
            <div class="o_weighing_record_footer">
                <button class="btn btn-primary" t-on-click="onSave">
                    <i class="fa fa-check"/> Record
                </button>
                <button class="btn btn-secondary" t-on-click="onCancel">
                    <i class="fa fa-times"/> Cancel
                </button>
            </div>
        </div>
    </t>
</templates>
