<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_move_line_weighing_tree" model="ir.ui.view">
        <field name="name">stock.move.line.weighing.tree</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="quantity"/>
                <field name="product_uom_id"/>
                <field name="recorded_weight"/>
                <field name="has_recorded_weight"/>
                <field name="weighing_user_id"/>
                <field name="weighing_date"/>
                <field name="location_id"/>
                <field name="location_dest_id"/>
                <field name="picking_id"/>
                <button name="action_weighing" type="object" string="Weigh"
                        icon="fa-balance-scale"/>
            </list>
        </field>
    </record>

    <record id="stock_move_line_weighing_action" model="ir.actions.act_window">
        <field name="name">Weighing Lines</field>
        <field name="res_model">stock.move.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('stock_move_line_weighing_tree')}),
            (0, 0, {'view_mode': 'form'})]"/>
        <field name="domain">[('has_recorded_weight', '=', True)]</field>
    </record>
</odoo>
