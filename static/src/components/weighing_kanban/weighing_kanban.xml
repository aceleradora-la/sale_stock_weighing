<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sale_stock_weighing.WeighingKanban" owl="1">
        <div class="o_weighing_kanban">
            <t t-foreach="props.records" t-as="record" t-key="record.resId">
                <div class="o_kanban_record"
                     t-attf-style="border-left: 4px solid #{record.data.weighing_state_color === 10 ? '#28a745' : record.data.weighing_state_color === 3 ? '#ffc107' : '#dc3545'}">
                    <div class="o_kanban_card_header">
                        <strong><t t-esc="record.data.product_id[1]"/></strong>
                        <span class="o_badge" t-attf-class="o_badge_#{record.data.weighing_state === 'weighed' ? 'success' : record.data.weighing_state === 'weighing' ? 'warning' : 'danger'}">
                            <t t-esc="record.data.weighing_state"/>
                        </span>
                    </div>
                    <div class="o_kanban_record_body">
                        <div>
                            <span>Planned: <t t-esc="record.data.product_uom_qty"/> <t t-esc="record.data.product_uom[1]"/></span>
                        </div>
                        <div>
                            <span>Done: <t t-esc="record.data.quantity"/> <t t-esc="record.data.product_uom[1]"/></span>
                        </div>
                        <div t-if="record.data.has_weight">
                            <span>Picked: <t t-esc="record.data.qty_picked"/> <t t-esc="record.data.product_uom[1]"/></span>
                        </div>
                        <div t-if="record.data.has_weight">
                            <span>Weight: <t t-esc="record.data.recorded_weight"/> <t t-esc="record.data.product_uom[1]"/></span>
                        </div>
                    </div>
                    <div class="o_kanban_record_bottom">
                        <div class="oe_kanban_bottom_left">
                            <button class="btn btn-primary btn-sm"
                                    t-on-click="() => this.onWeigh(record)"
                                    t-if="!record.data.is_weighing_operation_locked">
                                <i class="fa fa-balance-scale"/> Weigh
                            </button>
                        </div>
                        <div class="oe_kanban_bottom_right">
                            <button class="btn btn-sm"
                                    t-on-click="() => this.onPrint(record)"
                                    t-if="record.data.show_weighing_print_button">
                                <i class="fa fa-print"/>
                            </button>
                            <button class="btn btn-sm"
                                    t-on-click="() => this.onReset(record)"
                                    t-if="record.data.has_recorded_weight">
                                <i class="fa fa-undo"/>
                            </button>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
