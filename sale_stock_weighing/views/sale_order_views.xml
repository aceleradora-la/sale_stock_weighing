<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_view_weighing" model="ir.ui.view">
        <field name="name">sale.order.form.weighing</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Campo invisible para que column_invisible pueda leerlo desde la lista -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="company_use_stock_weighing" invisible="1"/>
            </xpath>

            <!-- Para productos pesables, el precio unitario es calculado (p/peso × peso);
                 se grisa para que el usuario edite solo el precio por peso.
                 El criterio es por FILA y no por columna: column_invisible oculta
                 la columna para toda la orden, asi que en una orden que mezcla
                 productos pesables y no pesables el hielo o el envase quedaban
                 sin ningun precio editable. Ahora conviven las dos columnas y
                 en cada linea se muestra la que corresponde.

                 El readonly se AGREGA a la condicion heredada con add/separator
                 en lugar de reemplazarla. Antes se escribia el atributo entero,
                 lo que borraba el `qty_invoiced > 0` de Odoo y, sobre todo,
                 dejaba el precio bloqueado en empresas que no usan pesaje y en
                 productos no pesables.

                 La condicion usa el campo is_weighed_product de la linea (un
                 related) y no product_id.is_weighed_product: los modificadores
                 no resuelven rutas con punto. -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                <attribute name="readonly" add="(parent.company_use_stock_weighing and is_weighed_product)" separator=" or "/>
                <attribute name="invisible" add="(parent.company_use_stock_weighing and is_weighed_product)" separator=" or "/>
                <attribute name="optional">show</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="is_weighed_product" column_invisible="1"/>
                <field name="price_per_weight"
                       column_invisible="not parent.company_use_stock_weighing"
                       invisible="not is_weighed_product"/>
                <field name="x_piece_count"
                       optional="show"
                       column_invisible="not parent.company_use_stock_weighing"
                       invisible="not is_weighed_product"
                       string="Piezas"/>
                <field name="total_planned_weight"
                       optional="show"
                       column_invisible="not parent.company_use_stock_weighing"
                       invisible="not is_weighed_product"
                       string="Peso Estimado"/>
                <field name="total_delivered_weight"
                       optional="show"
                       column_invisible="not parent.company_use_stock_weighing"
                       invisible="not is_weighed_product"
                       string="Peso Entregado"/>
                <field name="delivered_piece_count"
                       optional="hide"
                       column_invisible="not parent.company_use_stock_weighing"
                       invisible="not is_weighed_product"
                       string="Piezas Entregadas"/>
            </xpath>
        </field>
    </record>
</odoo>
