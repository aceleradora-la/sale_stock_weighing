<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_view_weighing" model="ir.ui.view">
        <field name="name">sale.order.form.weighing</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="price_unit" position="after">
                <field name="price_per_weight" optional="show" invisible="not product_id.is_weighed_product"/>
                <field name="total_planned_weight" optional="show" invisible="not product_id.is_weighed_product"/>
                <field name="total_delivered_weight" optional="show" invisible="not product_id.is_weighed_product"/>
            </field>
        </field>
    </record>
</odoo>
