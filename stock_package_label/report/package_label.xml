<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         ETIQUETA DE BULTO — PDF
         Layout en tabla HTML (más confiable que Bootstrap/flexbox en wkhtmltopdf).
         get_package_label_pages() devuelve lista de páginas → filas → etiquetas.
    ============================================================ -->

    <template id="report_package_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="picking">
                <t t-set="sale"    t-value="picking.sale_id"/>
                <t t-set="partner" t-value="picking.partner_id"/>
                <t t-set="weight"  t-value="picking.package_label_weight"/>
                <t t-set="wuom"    t-value="picking.package_label_weight_uom"/>
                <t t-set="cols"    t-value="int((data or {}).get('columns', 2))"/>
                <t t-set="rpp"     t-value="int((data or {}).get('rows_per_page', 3))"/>
                <t t-set="pages"  t-value="picking.get_package_label_pages(cols, rpp)"/>
                <t t-set="col_w"  t-value="str(round(100.0 / cols, 4)) + '%'"/>

                <t t-foreach="pages" t-as="page">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <t t-foreach="page" t-as="row">
                                <!-- Fila: divs flotantes, sin tabla (evita clipping de border-radius) -->
                                <div style="overflow:hidden; margin-bottom:8px; page-break-inside:avoid;">
                                    <t t-foreach="row" t-as="label">
                                        <div t-attf-style="float:left; width:#{col_w}; padding:4px; box-sizing:border-box;">
                                            <div style="border:2px solid #222; border-radius:5px; padding:12px 14px; font-family:Arial,sans-serif; box-sizing:border-box;">

                                                <!-- Encabezado: Bulto X/N + Fecha -->
                                                <div style="overflow:hidden; margin-bottom:4px;">
                                                    <div style="float:left;">
                                                        <span style="font-size:2.2em; font-weight:900; letter-spacing:1px;">
                                                            Bulto&#160;<t t-esc="label['number']"/>/<t t-esc="label['total']"/>
                                                        </span>
                                                    </div>
                                                    <div style="float:right; font-size:0.8em; color:#555; text-align:right;">
                                                        <t t-if="picking.scheduled_date">
                                                            <strong>Entrega:</strong><br/>
                                                            <t t-esc="picking.scheduled_date.strftime('%d/%m/%Y')"/>
                                                        </t>
                                                        <t t-elif="picking.date_done">
                                                            <strong>Fecha:</strong><br/>
                                                            <t t-esc="picking.date_done.strftime('%d/%m/%Y')"/>
                                                        </t>
                                                    </div>
                                                </div>

                                                <hr style="border:none; border-top:2px solid #222; margin:6px 0 10px 0; clear:both;"/>

                                                <!-- Cliente -->
                                                <div style="margin-bottom:8px;">
                                                    <div style="font-size:0.7em; color:#666; text-transform:uppercase; letter-spacing:1px;">Cliente</div>
                                                    <!-- display_name, no name: el partner del picking
                                                         es el contacto de entrega, y su nombre suelto
                                                         es solo "ENTREGA CAPILLA". display_name arma
                                                         "Empresa, Contacto" como muestra Odoo. -->
                                                    <div style="font-size:1.2em; font-weight:700;"><t t-esc="partner.display_name or ''"/></div>
                                                    <t t-if="partner.street">
                                                        <div style="font-size:0.88em; color:#333;">
                                                            <t t-esc="partner.street"/>
                                                            <t t-if="partner.street2">, <t t-esc="partner.street2"/></t>
                                                        </div>
                                                    </t>
                                                    <t t-if="partner.city or partner.state_id">
                                                        <div style="font-size:0.88em; color:#333;">
                                                            <t t-if="partner.zip"><t t-esc="partner.zip"/> — </t>
                                                            <t t-esc="partner.city or ''"/>
                                                            <t t-if="partner.state_id">, <t t-esc="partner.state_id.name"/></t>
                                                        </div>
                                                    </t>
                                                </div>

                                                <!-- Remito + Orden de Venta (divs flotantes, sin tabla) -->
                                                <div style="overflow:hidden; margin-bottom:6px;">
                                                    <div style="float:left; width:50%;">
                                                        <div style="font-size:0.7em; color:#666; text-transform:uppercase;">Remito</div>
                                                        <div style="font-size:1.0em; font-weight:600;"><t t-esc="picking.name"/></div>
                                                    </div>
                                                    <t t-if="sale">
                                                        <div style="float:left; width:50%;">
                                                            <div style="font-size:0.7em; color:#666; text-transform:uppercase;">Orden de Venta</div>
                                                            <div style="font-size:1.0em; font-weight:600;"><t t-esc="sale.name"/></div>
                                                        </div>
                                                    </t>
                                                </div>

                                                <!-- Peso -->
                                                <t t-if="weight">
                                                    <div style="margin-bottom:6px;">
                                                        <div style="font-size:0.7em; color:#666; text-transform:uppercase;">Peso despacho</div>
                                                        <div style="font-size:1.0em; font-weight:600;">
                                                            <t t-esc="'%.3f' % weight"/>&#160;<t t-esc="wuom"/>
                                                        </div>
                                                    </div>
                                                </t>

                                                <!-- Pie -->
                                                <div style="font-size:0.7em; color:#999; border-top:1px solid #eee; margin-top:8px; padding-top:5px;">
                                                    <t t-esc="picking.company_id.name or ''"/>
                                                    <t t-if="picking.company_id.phone"> · <t t-esc="picking.company_id.phone"/></t>
                                                </div>

                                            </div>
                                        </div>
                                    </t>
                                    <!-- Celdas vacías para completar la última fila -->
                                    <t t-foreach="range(cols - len(row))" t-as="empty">
                                        <div t-attf-style="float:left; width:#{col_w};"/>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <!-- ============================================================
         ETIQUETA DE BULTO — ZPL
         Formato para impresoras Zebra. Etiqueta 4"×6" portrait (812×1218 dots a 203 DPI).
         Una etiqueta ZPL por bulto.
    ============================================================ -->

    <template id="report_package_label_zpl">
        <t t-foreach="docs" t-as="picking">
            <t t-set="total"    t-value="picking.number_of_packages"/>
            <t t-set="sale"     t-value="picking.sale_id"/>
            <t t-set="partner"  t-value="picking.partner_id"/>
            <t t-set="weight"   t-value="picking.package_label_weight"/>
            <t t-set="wuom"     t-value="picking.package_label_weight_uom"/>

            <!-- Fecha -->
            <t t-set="ref_date"
               t-value="picking.date_done or picking.scheduled_date or picking.create_date"/>
            <t t-set="fecha" t-value="ref_date.strftime('%d/%m/%Y') if ref_date else ''"/>

            <!-- Dirección (evita coma inicial cuando no hay calle) -->
            <t t-set="zpl_street" t-value="partner.street or ''"/>
            <t t-set="zpl_city"   t-value="partner.city or ''"/>
            <!-- Dirección: línea 1 = calle · línea 2 = CP - Ciudad, Provincia -->
            <t t-set="zpl_line1" t-value="zpl_street[:38]"/>
            <t t-set="zpl_l2"    t-value="((partner.zip + ' - ' if partner.zip else '') + zpl_city + (', ' + partner.state_id.name if partner.state_id else ''))[:49]"/>

            <!-- Truncar textos para ZPL — etiqueta 10 cm × 6 cm (800 × 490 dots @ 203 DPI) -->
            <!-- cliente:   máx 30 chars — X=10, w=24 → 30×24+10=730 < 800 ✓
                 display_name y no name: el partner es el contacto de entrega y
                 su nombre suelto no dice de qué empresa es. Al truncar a 30 se
                 puede perder el final, pero se prioriza la empresa, que es lo
                 que identifica al destinatario. -->
            <t t-set="cliente"   t-value="(partner.display_name or '')[:30]"/>
            <!-- sale_name: máx 17 chars — X=10, w=22 → 17×22+10=384 < 400 ✓ -->
            <t t-set="sale_name" t-value="(sale.name if sale else '-')[:17]"/>
            <!-- barcode_ref: número de remito oficial si existe, sino picking.name -->
            <t t-set="barcode_ref" t-value="picking.package_label_barcode_ref or ''"/>
            <!-- remito: máx 16 chars — X=400, w=22 → 16×22+400=752 < 800 ✓ -->
            <t t-set="remito"      t-value="barcode_ref[:16]"/>
            <t t-set="peso_str"    t-value="('%.3f %s' % (weight, wuom)) if weight else ''"/>

            <t t-foreach="range(1, total + 1)" t-as="n">
                <!-- ── Inicio etiqueta: 10 cm × 6 cm, 203 DPI (800 × 490 dots) ── -->
                <t t-raw="'^XA\n^PW800\n^LL490\n^CI28\n^LH0,0\n'"/>

                <!-- "BULTO" pequeño arriba-izquierda -->
                <t t-raw="'^FO10,5^A0N,28,28^FDBULTO^FS\n'"/>

                <!-- Número "X/N" grande arriba-derecha — "12/20": 5×72+300=660 < 800 ✓ -->
                <t t-raw="'^FO300,5^A0N,95,72^FD'"/>
                <t t-esc="'%d/%d' % (n, total)"/>
                <t t-raw="'^FS\n'"/>

                <!-- Línea separadora gruesa -->
                <t t-raw="'^FO10,108^GB780,3,3^FS\n'"/>

                <!-- Cliente -->
                <t t-raw="'^FO10,118^A0N,20,20^FDCliente:^FS\n'"/>
                <t t-raw="'^FO10,142^A0N,26,24^FD'"/>
                <t t-esc="cliente"/>
                <t t-raw="'^FS\n'"/>

                <!-- Dirección: calle -->
                <t t-if="zpl_line1">
                    <t t-raw="'^FO10,178^A0N,20,20^FD'"/>
                    <t t-esc="zpl_line1"/>
                    <t t-raw="'^FS\n'"/>
                </t>
                <!-- Dirección: CP - Ciudad, Provincia (máx 49 chars, w=16 → 49×16+10=794 < 800) -->
                <t t-if="zpl_l2">
                    <t t-raw="'^FO10,201^A0N,18,16^FD'"/>
                    <t t-esc="zpl_l2"/>
                    <t t-raw="'^FS\n'"/>
                </t>

                <!-- Línea separadora fina -->
                <t t-raw="'^FO10,224^GB780,2,2^FS\n'"/>

                <!-- Orden de Venta + Remito (etiquetas) -->
                <t t-raw="'^FO10,232^A0N,18,18^FDOrden de Venta:^FS\n'"/>
                <t t-raw="'^FO400,232^A0N,18,18^FDRemito:^FS\n'"/>

                <!-- Orden de Venta + Remito (valores) -->
                <t t-raw="'^FO10,254^A0N,26,22^FD'"/>
                <t t-esc="sale_name"/>
                <t t-raw="'^FS\n'"/>
                <t t-raw="'^FO400,254^A0N,26,22^FD'"/>
                <t t-esc="remito"/>
                <t t-raw="'^FS\n'"/>

                <!-- Fecha y Peso -->
                <t t-raw="'^FO10,285^A0N,20,20^FDFecha: '"/>
                <t t-esc="fecha"/>
                <t t-raw="'^FS\n'"/>

                <t t-if="peso_str">
                    <t t-raw="'^FO400,285^A0N,20,20^FDPeso: '"/>
                    <t t-esc="peso_str"/>
                    <t t-raw="'^FS\n'"/>
                </t>

                <!-- Línea separadora fina -->
                <t t-raw="'^FO10,310^GB780,2,2^FS\n'"/>

                <!-- Código de barras Code-128 alineado a la izquierda -->
                <t t-raw="'^FO10,317^BY1,3,55^BCN,,Y,N,N^FD'"/>
                <t t-esc="barcode_ref"/>
                <t t-raw="'^FS\n'"/>

                <!-- Empresa (pie) — Y = 317+55+24 = 396 -->
                <t t-raw="'^FO10,399^A0N,18,18^FD'"/>
                <t t-esc="(picking.company_id.name or '')[:42]"/>
                <t t-raw="'^FS\n'"/>

                <!-- ── Fin de etiqueta ── -->
                <t t-raw="'^XZ\n'"/>
            </t>
        </t>
    </template>

    <!-- ============================================================
         Acciones de reporte
    ============================================================ -->

    <record id="action_report_package_label_pdf" model="ir.actions.report">
        <field name="name">Etiqueta de Bulto (PDF)</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_package_label.report_package_label</field>
        <field name="report_file">stock_package_label.report_package_label</field>
        <field name="print_report_name">'Etiquetas-Bultos-%s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_package_label_zpl" model="ir.actions.report">
        <field name="name">Etiqueta de Bulto (ZPL)</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">stock_package_label.report_package_label_zpl</field>
        <field name="report_file">stock_package_label.report_package_label_zpl</field>
        <field name="print_report_name">'Etiquetas-Bultos-ZPL-%s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
