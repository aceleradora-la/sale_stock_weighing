<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_package_label_layout_form" model="ir.ui.view">
        <field name="name">stock.package.label.layout.form</field>
        <field name="model">stock.package.label.layout</field>
        <field name="arch" type="xml">
            <form string="Imprimir Etiquetas de Bultos">
                <group>
                    <group string="Despacho">
                        <field name="picking_id" readonly="1"/>
                        <field name="number_of_packages" readonly="1"/>
                    </group>
                    <group string="Formato">
                        <field name="label_format" widget="radio"
                               options="{'horizontal': true}"/>
                    </group>
                </group>

                <!-- Opciones PDF: columnas × filas -->
                <group string="Distribución en hoja"
                       invisible="label_format != 'pdf'">
                    <field name="columns" string="Columnas por fila"/>
                    <field name="rows_per_page" string="Filas por hoja"/>
                    <label string="" for="columns"/>
                    <div class="text-muted small">
                        <i class="fa fa-info-circle"/>
                        Ejemplo: 2 columnas × 3 filas → 6 etiquetas por hoja A4
                    </div>
                </group>

                <!-- Info ZPL: impresora configurada via IoT -->
                <group string="Impresora Zebra"
                       invisible="label_format != 'zpl'">
                    <label string="" for="label_format"/>
                    <div class="text-muted">
                        <i class="fa fa-info-circle text-info me-1"/>
                        <strong>Impresora configurada vía IoT de Odoo.</strong><br/>
                        Si hay una impresora Zebra asignada al reporte
                        <em>Etiqueta de Bulto (ZPL)</em>, se enviará directo al imprimir.<br/>
                        Si no hay ninguna configurada, Odoo mostrará el selector de impresoras.<br/>
                        <br/>
                        Para configurar la impresora por defecto:<br/>
                        <strong>IoT → Dispositivos → [impresora Zebra] → Informes de la impresora → agregar "Etiqueta de Bulto (ZPL)"</strong>
                    </div>
                </group>

                <footer>
                    <button name="action_print" type="object"
                            string="Imprimir" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
