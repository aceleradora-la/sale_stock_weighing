<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_move_weighing_kanban" model="ir.ui.view">
        <field name="name">stock.move.weighing.kanban</field>
        <field name="model">stock.move</field>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="picking_id" sample="1">
                <field name="weighing_state"/>
                <field name="weighing_state_color"/>
                <field name="recorded_weight"/>
                <field name="qty_picked"/>
                <field name="has_weight"/>
                <field name="is_weighing_operation_locked"/>
                <field name="lot_names"/>
                <field name="origin_names"/>
                <field name="product_id"/>
                <field name="product_uom_qty"/>
                <field name="quantity"/>
                <field name="product_uom"/>
                <field name="picking_id"/>
                <field name="weighing_label_report_id"/>
                <field name="show_weighing_print_button"/>
                <progressbar field="weighing_state"
                             colors='{"weighed": "success", "weighing": "warning", "to_weigh": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card" t-attf-style="border-left: 3px solid #{kanban_color(record.weighing_state_color.raw_value)}">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_record_top">
                                    <strong class="o_kanban_record_title">
                                        <field name="product_id"/>
                                    </strong>
                                    <span class="badge" t-attf-class="badge-#{record.weighing_state.raw_value}">
                                        <field name="weighing_state"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="row">
                                    <div class="col-6">
                                        <span>Planned: </span>
                                        <field name="product_uom_qty"/>
                                        <field name="product_uom"/>
                                    </div>
                                    <div class="col-6">
                                        <span>Done: </span>
                                        <field name="quantity"/>
                                        <field name="product_uom"/>
                                    </div>
                                </div>
                                <div class="row" t-if="record.has_weight.raw_value">
                                    <div class="col-6">
                                        <span>Picked: </span>
                                        <field name="qty_picked"/>
                                        <field name="product_uom"/>
                                    </div>
                                    <div class="col-6">
                                        <span>Weight: </span>
                                        <field name="recorded_weight"/>
                                        <field name="product_uom"/>
                                    </div>
                                </div>
                                <div class="row" t-if="record.lot_names.raw_value">
                                    <div class="col-12">
                                        <span>Lots: </span>
                                        <field name="lot_names"/>
                                    </div>
                                </div>
                                <div class="row" t-if="record.origin_names.raw_value">
                                    <div class="col-12">
                                        <span>From: </span>
                                        <field name="origin_names"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <button name="action_weighing" type="object"
                                            class="btn btn-primary btn-sm"
                                            invisible="is_weighing_operation_locked">
                                        <i class="fa fa-balance-scale"/> Weigh
                                    </button>
                                    <button name="action_add_move_line" type="object"
                                            class="btn btn-secondary btn-sm"
                                            t-if="record.has_weight.raw_value">
                                        <i class="fa fa-plus"/> Add
                                    </button>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <button name="action_print_weight_record_label" type="object"
                                            class="btn btn-sm"
                                            t-if="record.show_weighing_print_button.raw_value">
                                        <i class="fa fa-print"/>
                                    </button>
                                    <button name="action_weight_detailed_operations" type="object"
                                            class="btn btn-sm"
                                            t-if="record.has_weight.raw_value">
                                        <i class="fa fa-expand"/>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="stock_move_weighing_tree" model="ir.ui.view">
        <field name="name">stock.move.weighing.tree</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <tree>
                <field name="picking_id"/>
                <field name="product_id"/>
                <field name="product_uom_qty"/>
                <field name="quantity"/>
                <field name="product_uom"/>
                <field name="has_weight" optional="hide"/>
                <field name="weighing_state"/>
                <field name="recorded_weight"/>
                <field name="qty_picked"/>
                <button name="action_weighing" type="object" string="Weigh"
                        icon="fa-balance-scale"
                        invisible="not has_weight"/>
            </tree>
        </field>
    </record>

    <record id="stock_move_weighing_form" model="ir.ui.view">
        <field name="name">stock.move.weighing.form</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_weighing" type="object"
                                class="oe_stat_button" icon="fa-balance-scale"
                                string="Weigh"/>
                        <button name="action_print_weight_record_label" type="object"
                                class="oe_stat_button" icon="fa-print"
                                string="Print Label"
                                invisible="not show_weighing_print_button"/>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="picking_id"/>
                            <field name="product_uom_qty"/>
                            <field name="quantity"/>
                            <field name="product_uom"/>
                        </group>
                        <group>
                            <field name="has_weight"/>
                            <field name="weighing_state"/>
                            <field name="recorded_weight"/>
                            <field name="qty_picked"/>
                            <field name="is_weighing_operation_locked"/>
                            <field name="weighing_user_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="move_lines" string="Detailed Operations">
                            <field name="move_line_ids">
                                <tree>
                                    <field name="product_id"/>
                                    <field name="lot_id"/>
                                    <field name="quantity"/>
                                    <field name="qty_picked"/>
                                    <field name="recorded_weight"/>
                                    <field name="has_recorded_weight"/>
                                    <field name="location_id"/>
                                    <field name="location_dest_id"/>
                                    <button name="action_weighing" type="object" string="Weigh"
                                            icon="fa-balance-scale"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="weighing_operation_action" model="ir.actions.act_window">
        <field name="name">Weighing Operations</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('stock_move_weighing_kanban')}),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('stock_move_weighing_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('stock_move_weighing_form')})]"/>
        <field name="context">{'default_weighing': True}</field>
        <field name="domain">[('state', 'in', ('assigned', 'confirmed', 'waiting'))]</field>
    </record>
</odoo>
