<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add the default device to the user Preferences dialog -->
    <record id="res_users_settings_view_form_remote_measure" model="ir.ui.view">
        <field name="name">res.users.settings.form.remote.measure</field>
        <field name="model">res.users.settings</field>
        <field name="inherit_id" ref="mail.res_users_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- In Odoo 19 the user settings form has a named group instead
                 of o_setting_box divs. We append our field after it. -->
            <xpath expr="//group[@name='discuss_user_settings']" position="after">
                <group string="Remote Devices">
                    <field name="remote_measure_device_id"
                           string="Default Scale Device"
                           help="Default device used by the weighing assistant for this user."/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
