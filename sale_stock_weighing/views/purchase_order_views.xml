<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_view_weighing" model="ir.ui.view">
        <field name="name">purchase.order.form.weighing</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Campo invisible para que column_invisible pueda leerlo desde la lista -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="company_use_stock_weighing" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="price_per_weight"
                       optional="show"
                       column_invisible="not parent.company_use_stock_weighing"
                       invisible="not product_id.is_weighed_product"/>
                <field name="total_received_weight"
                       optional="show"
                       column_invisible="not parent.company_use_stock_weighing"
                       invisible="not product_id.is_weighed_product"
                       string="Peso Recibido"/>
                <field name="received_piece_count"
                       optional="hide"
                       column_invisible="not parent.company_use_stock_weighing"
                       invisible="not product_id.is_weighed_product"
                       string="Piezas Recibidas"/>
            </xpath>
        </field>
    </record>
</odoo>
