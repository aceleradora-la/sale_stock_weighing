<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_weighing_label_document">
        <t t-call="web.external_layout">
            <div class="page">
                <t t-foreach="docs" t-as="move_line">
                    <t t-set="weighing_uom"
                       t-value="move_line.product_id.weighing_uom_id.name or 'kg'"/>
                    <t t-set="sale_line"
                       t-value="move_line.move_id.sale_line_id"/>
                    <t t-set="price_per_weight"
                       t-value="sale_line.price_per_weight if sale_line else 0.0"/>
                    <t t-set="piece_price"
                       t-value="move_line.recorded_weight * price_per_weight if price_per_weight else 0.0"/>
                    <t t-set="currency_symbol"
                       t-value="sale_line.order_id.currency_id.symbol if sale_line else ''"/>

                    <div class="row" style="border: 1px solid #000; padding: 15px; margin: 10px 0; page-break-inside: avoid;">
                        <!-- Row 1: Product + Lot -->
                        <div class="col-12">
                            <div class="row mb-2">
                                <div class="col-7">
                                    <strong>Producto:</strong>
                                    <p class="mb-0" t-field="move_line.product_id.display_name"/>
                                </div>
                                <div class="col-5">
                                    <strong>Lote / N° Serie:</strong>
                                    <p class="mb-0" t-if="move_line.lot_id" t-field="move_line.lot_id.name"/>
                                </div>
                            </div>

                            <!-- Row 2: Weight + Units + Date -->
                            <div class="row mb-2">
                                <div class="col-4">
                                    <strong>Peso:</strong>
                                    <p class="mb-0">
                                        <span style="font-size: 1.4em; font-weight: bold;"
                                              t-esc="'%.3f' % move_line.recorded_weight"/>
                                        <span class="ms-1" t-esc="weighing_uom"/>
                                    </p>
                                </div>
                                <div class="col-4">
                                    <strong>Unidades:</strong>
                                    <p class="mb-0">
                                        <span t-esc="'%.0f' % move_line.move_id.product_uom_qty"/>
                                        <span class="ms-1" t-field="move_line.product_uom_id.name"/>
                                    </p>
                                </div>
                                <div class="col-4">
                                    <strong>Fecha:</strong>
                                    <p class="mb-0" t-field="move_line.weighing_date"/>
                                </div>
                            </div>

                            <!-- Row 3: Price/kg + Piece Total (solo si viene de venta) -->
                            <t t-if="price_per_weight">
                                <div class="row mb-2" style="background: #f5f5f5; padding: 6px 0; border-radius: 4px;">
                                    <div class="col-6">
                                        <strong>Precio /
                                            <t t-esc="weighing_uom"/>:
                                        </strong>
                                        <p class="mb-0">
                                            <span t-esc="'%.2f' % price_per_weight"/>
                                            <span class="ms-1" t-esc="currency_symbol"/>
                                        </p>
                                    </div>
                                    <div class="col-6">
                                        <strong>Total Pieza:</strong>
                                        <p class="mb-0" style="font-size: 1.2em; font-weight: bold;">
                                            <span t-esc="'%.2f' % piece_price"/>
                                            <span class="ms-1" t-esc="currency_symbol"/>
                                        </p>
                                    </div>
                                </div>
                            </t>

                            <!-- Row 4: Operator + Picking -->
                            <div class="row">
                                <div class="col-6">
                                    <strong>Operador:</strong>
                                    <p class="mb-0" t-field="move_line.weighing_user_id.name"/>
                                </div>
                                <div class="col-6">
                                    <strong>Remito:</strong>
                                    <p class="mb-0" t-field="move_line.picking_id.name"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <template id="report_weighing_label">
        <t t-call="web.html_container">
            <t t-call="sale_stock_weighing.report_weighing_label_document"/>
        </t>
    </template>

    <template id="report_weighing_label_zpl">
        <t t-foreach="docs" t-as="move_line">
            <t t-set="weight_uom"
               t-value="move_line.product_id.weighing_uom_id.name if move_line.product_id.weighing_uom_id else 'kg'"/>
            <t t-set="sale_line" t-value="move_line.move_id.sale_line_id"/>
            <t t-set="price_per_weight" t-value="sale_line.price_per_weight if sale_line else 0.0"/>
            <t t-set="piece_price"
               t-value="move_line.recorded_weight * price_per_weight if price_per_weight else 0.0"/>
            <t t-set="currency" t-value="sale_line.order_id.currency_id.symbol if sale_line else ''"/>
            <t t-raw="'^XA^FO50,50^A0N,40,40^FDEtiqueta Pesaje^FS^FO50,100^A0N,30,30^FDProducto: %s^FS^FO50,150^A0N,30,30^FDLote: %s^FS^FO50,200^A0N,30,30^FDPeso: %s %s^FS^FO50,250^A0N,30,30^FDUnidades: %s %s^FS^FO50,300^A0N,30,30^FDPrecio/%s: %s %s^FS^FO50,350^A0N,35,35^FDTotal: %s %s^FS^FO50,410^A0N,30,30^FDFecha: %s^FS^FO50,460^A0N,30,30^FDRemito: %s^FS^XZ' % (
                move_line.product_id.display_name,
                move_line.lot_id.name if move_line.lot_id else '-',
                '%.3f' % move_line.recorded_weight, weight_uom,
                '%.0f' % move_line.move_id.product_uom_qty, move_line.product_uom_id.name,
                weight_uom, '%.2f' % price_per_weight, currency,
                '%.2f' % piece_price, currency,
                move_line.weighing_date.strftime('%d/%m/%Y %H:%M') if move_line.weighing_date else '-',
                move_line.picking_id.name,
            )"/>
        </t>
    </template>

    <record id="action_report_weighing_label" model="ir.actions.report">
        <field name="name">Etiqueta de Pesaje</field>
        <field name="model">stock.move.line</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_stock_weighing.report_weighing_label</field>
        <field name="report_file">sale_stock_weighing.report_weighing_label</field>
        <field name="print_report_name">'Etiqueta de Pesaje - %s' % (object.product_id.display_name)</field>
    </record>

    <record id="action_report_weighing_label_zpl" model="ir.actions.report">
        <field name="name">Etiqueta de Pesaje (ZPL)</field>
        <field name="model">stock.move.line</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">sale_stock_weighing.report_weighing_label_zpl</field>
        <field name="report_file">sale_stock_weighing.report_weighing_label_zpl</field>
        <field name="print_report_name">'Etiqueta-ZPL-%s' % (object.product_id.display_name)</field>
    </record>
</odoo>
