<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_move_weighing_kanban" model="ir.ui.view">
        <field name="name">stock.move.weighing.kanban</field>
        <field name="model">stock.move</field>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="weighing_state"/>
                <field name="weighing_state_color"/>
                <field name="recorded_weight"/>
                <field name="has_weight"/>
                <field name="is_weighing_operation_locked"/>
                <field name="lot_names"/>
                <field name="origin_names"/>
                <field name="product_id"/>
                <field name="product_uom_qty"/>
                <field name="quantity"/>
                <field name="product_uom"/>
                <field name="weighing_uom_name"/>
                <field name="picking_id"/>
                <field name="show_weighing_print_button"/>
                <progressbar field="weighing_state"
                             colors='{"weighed": "success", "weighing": "warning", "to_weigh": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record">
                            <div class="o_kanban_record_top">
                                <strong class="o_kanban_record_title">
                                    <field name="product_id"/>
                                </strong>
                                <span class="badge text-bg-success" t-if="record.weighing_state.raw_value === 'weighed'">
                                    <field name="weighing_state"/>
                                </span>
                                <span class="badge text-bg-warning" t-if="record.weighing_state.raw_value === 'weighing'">
                                    <field name="weighing_state"/>
                                </span>
                                <span class="badge text-bg-danger" t-if="record.weighing_state.raw_value === 'to_weigh'">
                                    <field name="weighing_state"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <span>Planificado: </span>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom"/>
                                </div>
                                <div>
                                    <span>Realizado: </span>
                                    <field name="quantity"/>
                                    <field name="product_uom"/>
                                </div>
                                <div t-if="record.has_weight.raw_value and record.recorded_weight.raw_value">
                                    <span>Peso: </span>
                                    <field name="recorded_weight"/>
                                    <t t-if="record.weighing_uom_name.raw_value">
                                        <t t-esc="record.weighing_uom_name.raw_value"/>
                                    </t>
                                </div>
                                <div t-if="record.lot_names.raw_value">
                                    <span>Lotes: </span>
                                    <field name="lot_names"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <button name="action_weighing" type="object"
                                            class="btn btn-primary btn-sm"
                                            t-if="!record.is_weighing_operation_locked.raw_value">
                                        <i class="fa fa-balance-scale"/> Pesar
                                    </button>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <button name="action_print_weight_record_label" type="object"
                                            class="btn btn-sm"
                                            t-if="record.show_weighing_print_button.raw_value">
                                        <i class="fa fa-print"/>
                                    </button>
                                    <button name="action_weight_detailed_operations" type="object"
                                            class="btn btn-sm"
                                            t-if="record.has_weight.raw_value">
                                        <i class="fa fa-expand"/>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="stock_move_weighing_tree" model="ir.ui.view">
        <field name="name">stock.move.weighing.tree</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <!-- Grilla de carga: editable para tipear los pesos de corrido.
                 decoration-* pinta la fila según el estado de pesaje (semáforo). -->
            <!-- abs() no existe en el evaluador de vistas de Odoo: se compara por rango. -->
            <list editable="bottom" create="0" delete="0"
                  decoration-muted="weighing_state == 'to_weigh'"
                  decoration-danger="weight_deviation_pct &gt; 30 or weight_deviation_pct &lt; -30">
                <field name="has_weight" column_invisible="1"/>
                <field name="weighing_detail_level" column_invisible="1"/>
                <field name="weighing_state" widget="badge"
                       decoration-success="weighing_state == 'weighed'"
                       decoration-warning="weighing_state == 'weighing'"
                       decoration-info="weighing_state == 'to_weigh'"
                       readonly="1" string="Estado"/>
                <field name="picking_id" readonly="1" optional="show"/>
                <field name="product_id" readonly="1"/>
                <field name="product_uom_qty" readonly="1" string="Cant."/>
                <field name="quantity" readonly="1" optional="hide"/>
                <field name="product_uom" readonly="1" optional="hide"/>
                <field name="planned_weight" readonly="1" string="Est."/>
                <field name="recorded_weight"
                       string="Peso real"
                       readonly="weighing_detail_level == 'piece'"/>
                <field name="weight_deviation_pct" readonly="1" optional="show"
                       widget="percentage"/>
                <field name="piece_progress" readonly="1" optional="show"/>
                <button name="action_weight_detailed_operations" type="object"
                        string="Detalle" icon="fa-list-ul"
                        invisible="weighing_detail_level != 'piece' or not has_weight"/>
                <button name="action_weighing" type="object" string="Pesar"
                        icon="fa-balance-scale"
                        invisible="not has_weight"/>
            </list>
        </field>
    </record>

    <record id="stock_move_weighing_form" model="ir.ui.view">
        <field name="name">stock.move.weighing.form</field>
        <field name="model">stock.move</field>
        <!-- Alta prioridad para que el action use esta vista y no la estándar de Odoo -->
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_weighing" type="object"
                                class="oe_stat_button" icon="fa-balance-scale"
                                string="Pesar"/>
                        <button name="action_print_weight_record_label" type="object"
                                class="oe_stat_button" icon="fa-print"
                                string="Imprimir Etiqueta"
                                invisible="not show_weighing_print_button"/>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="picking_id"/>
                            <field name="product_uom_qty"/>
                            <field name="quantity"/>
                            <field name="product_uom"/>
                        </group>
                        <group>
                            <field name="has_weight"/>
                            <field name="weighing_state"/>
                            <field name="recorded_weight"/>
                            <field name="is_weighing_operation_locked"/>
                            <field name="weighing_user_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="move_lines" string="Operaciones Detalladas">
                            <!-- Una fila por pieza: se dejan a la vista solo las
                                 columnas que se usan al pesar. -->
                            <field name="move_line_ids">
                                <list editable="bottom">
                                    <field name="product_id" optional="hide"/>
                                    <field name="lot_id" string="Lote"/>
                                    <field name="quantity" string="Cant."/>
                                    <field name="recorded_weight" string="Peso"/>
                                    <field name="has_recorded_weight" optional="hide"/>
                                    <field name="location_id" optional="hide"/>
                                    <field name="location_dest_id" optional="hide"/>
                                    <button name="action_weighing" type="object" string="Pesar"
                                            icon="fa-balance-scale"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="weighing_operation_action" model="ir.actions.act_window">
        <field name="name">Operaciones de Pesaje</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">kanban,list,form</field>
        <!-- view_id fuerza el formulario de pesaje al abrir un registro -->
        <field name="view_id" ref="stock_move_weighing_form"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('stock_move_weighing_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('stock_move_weighing_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('stock_move_weighing_form')})]"/>
        <field name="context">{'default_weighing': True}</field>
        <field name="domain">[('state', 'in', ('assigned', 'confirmed', 'waiting'))]</field>
    </record>
</odoo>
