<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_weighing" model="ir.ui.view">
        <field name="name">res.config.settings.view.weighing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Pesaje"
                     data-key="sale_stock_weighing" groups="base.group_system">
                    <h2>Pesaje de Productos</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="use_stock_weighing"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="use_stock_weighing"/>
                                <div class="text-muted">
                                    Activa las columnas de pesaje en órdenes
                                    de venta y remitos para esta empresa.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
