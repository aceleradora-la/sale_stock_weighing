<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_type_form_view_weighing" model="ir.ui.view">
        <field name="name">stock.picking.type.form.weighing</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <group name="additional_info" position="inside">
                <group name="weighing" string="Weighing">
                    <field name="weighing_operations"/>
                    <field name="print_weighing_label" attrs="{'invisible': [('weighing_operations', '=', False)]}"/>
                    <field name="weighing_label_report_id" attrs="{'invisible': [('weighing_operations', '=', False)]}"/>
                </group>
            </group>
        </field>
    </record>

    <record id="stock_picking_type_tree_view_weighing" model="ir.ui.view">
        <field name="name">stock.picking.type.tree.weighing</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_tree"/>
        <field name="arch" type="xml">
            <field name="use_create_lots" position="after">
                <field name="weighing_operations" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
