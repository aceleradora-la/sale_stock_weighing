<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         ETIQUETA DE BULTO — PDF
         Genera una etiqueta por cada bulto (1/N, 2/N, …, N/N).
         Modelo: stock.picking
    ============================================================ -->

    <template id="report_package_label_document">
        <t t-call="web.external_layout">
            <div class="page">
                <t t-foreach="docs" t-as="picking">

                    <t t-set="total"    t-value="picking.number_of_packages"/>
                    <t t-set="sale"     t-value="picking.sale_id"/>
                    <t t-set="partner"  t-value="picking.partner_id"/>
                    <t t-set="weight"   t-value="picking.package_label_weight"/>
                    <t t-set="wuom"     t-value="picking.package_label_weight_uom"/>
                    <t t-set="packages" t-value="picking.move_line_ids.result_package_id"/>

                    <!-- Una etiqueta por bulto -->
                    <t t-foreach="range(1, total + 1)" t-as="n">
                        <t t-set="package" t-value="packages[n - 1] if packages and n &lt;= len(packages) else False"/>

                        <div style="
                            border: 2px solid #222;
                            border-radius: 6px;
                            padding: 20px 24px;
                            margin-bottom: 20px;
                            page-break-inside: avoid;
                            page-break-after: always;
                            font-family: Arial, sans-serif;
                        ">
                            <!-- Encabezado: número de bulto -->
                            <div class="row mb-3">
                                <div class="col-8">
                                    <span style="font-size: 3em; font-weight: 900; letter-spacing: 2px;">
                                        Bulto&#160;<t t-esc="n"/>/<t t-esc="total"/>
                                    </span>
                                </div>
                                <div class="col-4 text-end" style="font-size: 0.85em; color: #555;">
                                    <t t-if="picking.scheduled_date">
                                        <strong>Fecha entrega:</strong><br/>
                                        <t t-esc="picking.scheduled_date.strftime('%d/%m/%Y')"/>
                                    </t>
                                    <t t-elif="picking.date_done">
                                        <strong>Fecha:</strong><br/>
                                        <t t-esc="picking.date_done.strftime('%d/%m/%Y')"/>
                                    </t>
                                </div>
                            </div>

                            <hr style="border-color: #222; margin: 8px 0 16px 0;"/>

                            <!-- Datos del cliente -->
                            <div class="row mb-3">
                                <div class="col-12">
                                    <div style="font-size: 0.75em; color: #666; text-transform: uppercase; letter-spacing: 1px;">Cliente</div>
                                    <div style="font-size: 1.4em; font-weight: 700;">
                                        <t t-esc="partner.name or ''"/>
                                    </div>
                                    <t t-if="partner.street">
                                        <div style="font-size: 0.95em; color: #333;">
                                            <t t-esc="partner.street"/>
                                            <t t-if="partner.street2">, <t t-esc="partner.street2"/></t>
                                        </div>
                                    </t>
                                    <t t-if="partner.city or partner.state_id">
                                        <div style="font-size: 0.95em; color: #333;">
                                            <t t-if="partner.zip"><t t-esc="partner.zip"/> — </t>
                                            <t t-esc="partner.city or ''"/>
                                            <t t-if="partner.state_id">, <t t-esc="partner.state_id.name"/></t>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <!-- Datos del despacho -->
                            <div class="row mb-2">
                                <div class="col-6">
                                    <div style="font-size: 0.75em; color: #666; text-transform: uppercase;">Remito</div>
                                    <div style="font-size: 1.1em; font-weight: 600;">
                                        <t t-esc="picking.name"/>
                                    </div>
                                </div>
                                <div class="col-6" t-if="sale">
                                    <div style="font-size: 0.75em; color: #666; text-transform: uppercase;">Orden de Venta</div>
                                    <div style="font-size: 1.1em; font-weight: 600;">
                                        <t t-esc="sale.name"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Peso e info del paquete -->
                            <div class="row mt-2">
                                <div class="col-6" t-if="weight">
                                    <div style="font-size: 0.75em; color: #666; text-transform: uppercase;">Peso Total Despacho</div>
                                    <div style="font-size: 1.1em; font-weight: 600;">
                                        <t t-esc="'%.3f' % weight"/>
                                        <span class="ms-1" t-esc="wuom"/>
                                    </div>
                                </div>
                                <div class="col-6" t-if="package and package.name">
                                    <div style="font-size: 0.75em; color: #666; text-transform: uppercase;">Paquete</div>
                                    <div style="font-size: 1.0em; font-weight: 600;">
                                        <t t-esc="package.name"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Pie: empresa -->
                            <div class="row mt-3">
                                <div class="col-12" style="font-size: 0.75em; color: #888; border-top: 1px solid #ddd; padding-top: 8px;">
                                    <t t-esc="picking.company_id.name"/>
                                    <t t-if="picking.company_id.phone"> · <t t-esc="picking.company_id.phone"/></t>
                                    <t t-if="picking.company_id.email"> · <t t-esc="picking.company_id.email"/></t>
                                </div>
                            </div>

                        </div>
                    </t>
                </t>
            </div>
        </t>
    </template>

    <template id="report_package_label">
        <t t-call="web.html_container">
            <t t-call="stock_package_label.report_package_label_document"/>
        </t>
    </template>

    <!-- ============================================================
         ETIQUETA DE BULTO — ZPL
         Formato para impresoras Zebra. Etiqueta 4"×6" portrait (812×1218 dots a 203 DPI).
         Una etiqueta ZPL por bulto.

         Layout de posiciones (Y en dots):
           15  → "BULTO" (label pequeño, 55pt)
           80  → "X/N"   (número grande, 160×130pt — máx "12/20" = 5×130+30=680 < 812 ✓)
           265 → línea separadora gruesa
           285 → "Cliente:" label
           320 → nombre del cliente (44pt)
           375 → dirección (28pt)
           415 → línea separadora fina
           435 → "Orden de Venta:" / "Remito:"  (labels)
           468 → valores OS / Remito (38pt)
           520 → "Fecha:" / "Peso:"
           560 → línea separadora fina
           580 → código de barras Code-128 (altura 90)
           715 → nombre empresa (22pt)
    ============================================================ -->

    <template id="report_package_label_zpl">
        <t t-foreach="docs" t-as="picking">
            <t t-set="total"    t-value="picking.number_of_packages"/>
            <t t-set="sale"     t-value="picking.sale_id"/>
            <t t-set="partner"  t-value="picking.partner_id"/>
            <t t-set="weight"   t-value="picking.package_label_weight"/>
            <t t-set="wuom"     t-value="picking.package_label_weight_uom"/>
            <t t-set="packages" t-value="picking.move_line_ids.result_package_id"/>

            <!-- Fecha -->
            <t t-set="ref_date"
               t-value="picking.date_done or picking.scheduled_date or picking.create_date"/>
            <t t-set="fecha" t-value="ref_date.strftime('%d/%m/%Y') if ref_date else ''"/>

            <!-- Armar dirección evitando coma inicial cuando no hay calle -->
            <t t-set="_street" t-value="partner.street or ''"/>
            <t t-set="_city"   t-value="partner.city or ''"/>
            <t t-set="direccion"
               t-value="(_street + (', ' + _city if _city else ''))[:42] if _street else _city[:42]"/>

            <!-- Truncar textos para ZPL -->
            <t t-set="cliente"   t-value="(partner.name or '')[:36]"/>
            <t t-set="sale_name" t-value="(sale.name if sale else '-')[:20]"/>
            <t t-set="remito"    t-value="(picking.name or '')[:20]"/>
            <t t-set="peso_str"  t-value="('%.3f %s' % (weight, wuom)) if weight else ''"/>

            <t t-foreach="range(1, total + 1)" t-as="n">
                <t t-set="package" t-value="packages[n - 1] if packages and n &lt;= len(packages) else False"/>

                <!-- ── Inicio etiqueta: 4"×6" portrait, 203 DPI ── -->
                <t t-raw="'^XA\n^PW812\n^LL1218\n^CI28\n^LH0,0\n'"/>

                <!-- "BULTO" en pequeño (Y=15, h=55, w=55 → 5 chars × 55 = 275 + 30 = 305 ✓) -->
                <t t-raw="'^FO30,15^A0N,55,55^FDBULTO^FS\n'"/>

                <!-- Número "X/N" grande (Y=80, h=160, w=130 → max "12/20"=5×130+30=680 < 812 ✓) -->
                <t t-raw="'^FO30,80^A0N,160,130^FD'"/>
                <t t-esc="'%d/%d' % (n, total)"/>
                <t t-raw="'^FS\n'"/>

                <!-- Línea separadora gruesa -->
                <t t-raw="'^FO30,265^GB752,5,5^FS\n'"/>

                <!-- Cliente -->
                <t t-raw="'^FO30,285^A0N,26,26^FDCliente:^FS\n'"/>
                <t t-raw="'^FO30,318^A0N,44,44^FD'"/>
                <t t-esc="cliente"/>
                <t t-raw="'^FS\n'"/>

                <!-- Dirección -->
                <t t-if="direccion">
                    <t t-raw="'^FO30,373^A0N,28,28^FD'"/>
                    <t t-esc="direccion"/>
                    <t t-raw="'^FS\n'"/>
                </t>

                <!-- Línea separadora fina -->
                <t t-raw="'^FO30,415^GB752,2,2^FS\n'"/>

                <!-- Orden de Venta -->
                <t t-raw="'^FO30,435^A0N,24,24^FDOrden de Venta:^FS\n'"/>
                <t t-raw="'^FO30,465^A0N,38,38^FD'"/>
                <t t-esc="sale_name"/>
                <t t-raw="'^FS\n'"/>

                <!-- Remito -->
                <t t-raw="'^FO430,435^A0N,24,24^FDRemito:^FS\n'"/>
                <t t-raw="'^FO430,465^A0N,38,38^FD'"/>
                <t t-esc="remito"/>
                <t t-raw="'^FS\n'"/>

                <!-- Fecha y Peso -->
                <t t-raw="'^FO30,520^A0N,26,26^FDFecha: '"/>
                <t t-esc="fecha"/>
                <t t-raw="'^FS\n'"/>

                <t t-if="peso_str">
                    <t t-raw="'^FO430,520^A0N,26,26^FDPeso: '"/>
                    <t t-esc="peso_str"/>
                    <t t-raw="'^FS\n'"/>
                </t>

                <!-- Línea separadora fina -->
                <t t-raw="'^FO30,560^GB752,2,2^FS\n'"/>

                <!-- Código de barras Code-128 con número de remito (alto=90, HRI=Y) -->
                <t t-raw="'^FO80,580^BY2,3,90^BCN,,Y,N,N^FD'"/>
                <t t-esc="picking.name"/>
                <t t-raw="'^FS\n'"/>

                <!-- Empresa (pie) -->
                <t t-raw="'^FO30,715^A0N,22,22^FD'"/>
                <t t-esc="(picking.company_id.name or '')[:42]"/>
                <t t-raw="'^FS\n'"/>

                <!-- ── Fin de etiqueta ── -->
                <t t-raw="'^XZ\n'"/>
            </t>
        </t>
    </template>

    <!-- ============================================================
         Acciones de reporte
    ============================================================ -->

    <record id="action_report_package_label_pdf" model="ir.actions.report">
        <field name="name">Etiqueta de Bulto (PDF)</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_package_label.report_package_label</field>
        <field name="report_file">stock_package_label.report_package_label</field>
        <field name="print_report_name">'Etiquetas-Bultos-%s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_package_label_zpl" model="ir.actions.report">
        <field name="name">Etiqueta de Bulto (ZPL)</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-text</field>
        <field name="report_name">stock_package_label.report_package_label_zpl</field>
        <field name="report_file">stock_package_label.report_package_label_zpl</field>
        <field name="print_report_name">'Etiquetas-Bultos-ZPL-%s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
