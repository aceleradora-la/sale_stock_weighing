<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_line_form_weighing" model="ir.ui.view">
        <field name="name">account.move.line.form.weighing</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <field name="quantity" position="after">
                <field name="recorded_weight" invisible="not recorded_weight"/>
                <field name="weight_uom_id" invisible="not weight_uom_id"/>
            </field>
        </field>
    </record>

    <record id="account_move_form_weighing" model="ir.ui.view">
        <field name="name">account.move.form.weighing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <field name="company_use_stock_weighing" invisible="1"/>
                <button name="action_recompute_weight_lines" type="object"
                        class="oe_stat_button" icon="fa-balance-scale"
                        string="Actualizar por Peso"
                        invisible="state != 'draft' or move_type not in ('out_invoice', 'out_refund') or not company_use_stock_weighing"/>
            </xpath>
        </field>
    </record>
</odoo>
