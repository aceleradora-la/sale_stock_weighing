<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_type_form_inherit_package_label" model="ir.ui.view">
        <field name="name">stock.picking.type.form.package.label</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <!-- Agrega grupo debajo de los grupos estándar (anchor siempre presente en stock) -->
            <group name="second" position="after">
                <group name="package_label" string="Etiqueta de Bulto">
                    <field name="package_label_format"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
