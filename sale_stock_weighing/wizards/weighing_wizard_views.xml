<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="weighing_wizard_view_form" model="ir.ui.view">
        <field name="name">weighing.wizard.form</field>
        <field name="model">weighing.wizard</field>
        <field name="arch" type="xml">
            <form string="Asistente de Pesaje">
                <group>
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="move_id" readonly="1"/>
                        <field name="selected_move_line_id" readonly="1"
                               invisible="not selected_move_line_id"/>
                        <field name="remaining_count" string="Restantes"/>
                    </group>
                    <group>
                        <!-- Remote measure widget: shows balance icon when a device
                             is configured in user preferences. Falls back to plain
                             numeric input when no device is set. -->
                        <field name="weight"
                               widget="remote_measure"
                               options="{'default_user_device': true, 'uom_field': 'weight_uom_id'}"
                               class="oe_inline"
                               style="font-size: 200%; font-weight: bold;"/>
                        <field name="weight_uom_id" invisible="1"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="lot_id" invisible="product_tracking == 'none'"/>
                        <field name="product_tracking" invisible="1"/>
                    </group>
                    <group>
                        <field name="print_label"/>
                    </group>
                </group>
                <footer>
                    <button name="record_weight" type="object"
                            string="Registrar Peso" class="btn-primary"/>
                    <button name="action_close" type="object"
                            string="Cerrar" class="btn-secondary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="weighing_wizard_action" model="ir.actions.act_window">
        <field name="name">Asistente de Pesaje</field>
        <field name="res_model">weighing.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="weighing_action_incoming" model="ir.actions.act_window">
        <field name="name">Pesaje Entrante</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[
            ('state', 'in', ('assigned', 'confirmed', 'waiting')),
            ('picking_type_id.code', '=', 'incoming'),
            ('has_weight', '=', True),
        ]</field>
        <field name="context">{'group_by': ['picking_id']}</field>
    </record>

    <record id="weighing_action_outgoing" model="ir.actions.act_window">
        <field name="name">Pesaje Saliente</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[
            ('state', 'in', ('assigned', 'confirmed', 'waiting')),
            ('picking_type_id.code', '=', 'outgoing'),
            ('has_weight', '=', True),
        ]</field>
        <field name="context">{'group_by': ['picking_id']}</field>
    </record>

    <menuitem id="menu_weighing_root"
              name="Pesaje"
              parent="stock.menu_stock_root"
              sequence="50"/>

    <menuitem id="menu_weighing_incoming"
              name="Pesaje Entrante"
              parent="menu_weighing_root"
              action="weighing_action_incoming"
              sequence="10"/>

    <menuitem id="menu_weighing_outgoing"
              name="Pesaje Saliente"
              parent="menu_weighing_root"
              action="weighing_action_outgoing"
              sequence="20"/>
</odoo>
