<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_pricelist_item_form_weighing" model="ir.ui.view">
        <field name="name">product.pricelist.item.form.weighing</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            <!-- Campo invisible necesario para condicionar visibilidad -->
            <field name="applied_on" position="before">
                <field name="company_use_stock_weighing" invisible="1"/>
            </field>
            <!-- Campos de pesaje debajo de Precio fijo, antes del grupo de fechas -->
            <xpath expr="//group[@name='pricelist_rule_limits']" position="before">
                <group invisible="not company_use_stock_weighing">
                    <field name="is_weighed_price"/>
                    <field name="price_per_weight"
                           invisible="not is_weighed_price or compute_price != 'fixed'"/>
                    <field name="weight_price_display"
                           invisible="not is_weighed_price"
                           readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Agrega la columna Precio por Peso directamente en la lista embebida
         del form de pricelist, que en Odoo 19 no usa la tree view standalone. -->
    <record id="product_pricelist_form_weighing" model="ir.ui.view">
        <field name="name">product.pricelist.form.weighing</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='item_ids']" position="before">
                <field name="company_use_stock_weighing" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='item_ids']//field[@name='price']" position="after">
                <field name="weight_price_display" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="product_pricelist_item_tree_weighing" model="ir.ui.view">
        <field name="name">product.pricelist.item.tree.weighing</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_tree_view"/>
        <field name="arch" type="xml">
            <field name="price" position="after">
                <field name="weight_price_display" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
