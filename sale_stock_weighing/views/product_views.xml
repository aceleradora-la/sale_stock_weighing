<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_weighing" model="ir.ui.view">
        <field name="name">product.template.form.weighing</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <group name="inventory" position="inside">
                <group name="weighing" string="Weighing">
                    <field name="is_weighed_product"/>
                    <field name="weighing_uom_id" invisible="not is_weighed_product" required="is_weighed_product"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
