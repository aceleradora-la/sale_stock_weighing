msgid "Weighed Product Price"
msgstr "Precio por peso"

msgid "Apply pricing rules to price per kg instead of price per unit."
msgstr "Aplicar las reglas de precio al precio por kg en lugar del precio por unidad."

msgid "Price per Weight Unit"
msgstr "Precio por unidad de peso"

msgid "Price per weight unit (e.g. per kg) for weighed products."
msgstr "Precio por unidad de peso (ej: por kg) para productos pesables."

msgid "Weight UoM"
msgstr "UdM de peso"

msgid "Price per weight unit (e.g. per kg). Used when the product is sold by units but invoiced by weight."
msgstr "Precio por unidad de peso (ej: por kg). Se usa cuando el producto se vende por unidades pero se factura por peso."

msgid "Total Planned Weight"
msgstr "Peso total planificado"

msgid "Planned total weight based on order quantity and standard weight."
msgstr "Peso total planificado basado en la cantidad de pedido y peso estándar."

msgid "Total Delivered Weight"
msgstr "Peso total entregado"

msgid "Actual total weight delivered from stock moves."
msgstr "Peso total real entregado desde los movimientos de stock."

msgid "No move line selected"
msgstr "No se seleccionó ninguna línea de movimiento"

msgid "Weighing Operations"
msgstr "Operaciones de pesaje"

msgid "Auto Print Weighing Label"
msgstr "Imprimir automáticamente etiqueta de pesaje"

msgid "Weighing Label Format"
msgstr "Formato de etiqueta de pesaje"

msgid "Weighing User"
msgstr "Usuario de pesaje"

msgid "User currently weighing this operation. Locks the operation for others."
msgstr "Usuario que está pesando esta operación. Bloquea la operación para otros."

msgid "Has Recorded Weight"
msgstr "Tiene peso registrado"

msgid "The weight was set from the weighing wizard"
msgstr "El peso fue establecido desde el asistente de pesaje"

msgid "Recorded Weight"
msgstr "Peso registrado"

msgid "Actual weight recorded during weighing operation"
msgstr "Peso real registrado durante la operación de pesaje"

msgid "Picked Quantity"
msgstr "Cantidad recogida"

msgid "Weight picked during weighing. Used to compute delivered weight."
msgstr "Peso recogido durante el pesaje. Se usa para calcular el peso entregado."
